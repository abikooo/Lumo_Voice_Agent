{
    "manifest_version": 3,
    "name": "LumoAI",
    "description": "LumoAI - Your AI Study Assistant",
    "version": "1.0.0",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "tabCapture",
        "activeTab",
        "offscreen",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "http://localhost:8000/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    }
}